modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
MONITOR_APP_URL = "https://elexon-insights-mcp-server.replit.app"
MONITOR_EMAIL_DRY_RUN = "true"
MONITOR_EMAIL_ENABLED = "false"
MONITOR_EMAIL_FROM = "support@davder.com"
MONITOR_EMAIL_TO = "support@davder.com"
