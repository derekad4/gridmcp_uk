{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "monitor:once": "tsx src/monitor-worker.ts",
    "monitor:watchdog": "tsx src/monitor-worker.ts --watchdog",
    "monitor:alerts:test": "tsx --test src/lib/monitoring/alerts.test.ts",
    "ask:verify-data": "tsx scripts/verify-ask-data.ts",
    "catalog:generate": "node scripts/generate-elexon-catalog.mjs",
    "test": "tsx --test src/lib/ask/model.test.ts src/lib/endpoint-tools.test.ts src/lib/public-observations.test.ts src/lib/ask/ask.test.ts src/lib/ask/calculations.test.ts src/lib/monitoring/monitoring.test.ts src/lib/monitoring/alerts.test.ts",
    "catalog:verify": "node scripts/verify-elexon-coverage.mjs",
    "catalog:test": "node --test scripts/elexon-coverage.test.mjs",
    "endpoints:smoke": "tsx scripts/smoke-elexon-endpoints.ts",
    "endpoints:smoke:test": "tsx --test src/lib/endpoint-smoke.test.ts",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@replit/connectors-sdk": "^0.7.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/elexon-labels": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docx": "^9.15.4",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "fontkit": "^3.0.0",
    "pdfkit": "^0.20.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fontkit": "^2.0.9",
    "@types/node": "catalog:",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^7.2.1",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
